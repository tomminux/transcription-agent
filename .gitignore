/target
/models
.env
# Keep folders, ignore their contents (private audio and transcripts)
/new-audio-files/*
/transcriptions/*
/transcribed-audio-files/*
!/new-audio-files/.gitkeep
!/transcriptions/.gitkeep
!/transcribed-audio-files/.gitkeep
.DS_Store

# Never commit audio or generated reports, wherever they end up
*.m4a
*.wav
*.mp3
*.flac
*-report.md
